<h1>Edit Task</h1>

<%= form_with url: task_path(@task["id"]), method: :put do %>

  <div>
    <label>Task Name</label>
    <br>

    <input
      type="text"
      name="name"
      value="<%= @task["name"] %>"
    >
  </div>

  <br>

  <div>
    <label>Done</label>

    <input
      type="checkbox"
      name="done"
      value="1"
      <%= "checked" if @task["done"] %>
    >
  </div>

  <br>

  <button>Update Task</button>

<% end %>

<br>

<%= link_to "Back", tasks_path %>