<h1>New Task</h1>

<%= form_with url: tasks_path, method: :post do %>

  <div>
    <label>Task Name</label>
    <br>
    <input type="text" name="name">
  </div>

  <br>

  <div>
    <label>Done</label>
    <input type="checkbox" name="done" value="1">
  </div>

  <br>

  <button>Create Task</button>

<% end %>

<br>

<%= link_to "Back", tasks_path %>